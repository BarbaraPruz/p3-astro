---
import { Font } from "astro:assets";
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";

interface Props {
  title?: string;
}

const { title = "P3 Studio Hawaii" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
      <Font cssVariable="--font-playfair" />
      <Font cssVariable="--font-montserrat" />
        <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      const stored = localStorage.getItem('theme');
      const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <Header />
    <main class="page-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    font-family:
      system-ui,
      -apple-system,
      Segoe UI,
      Roboto,
      sans-serif;

    --color-bg: #fff;
    --color-text: #1e1e2e;
    --color-muted-text: #4d4d4d;
    --color-accent-border: #cca533;

    color-scheme: light;
  }

  [data-theme="dark"] {
    --color-bg: #081523; /*#0a0a0a;*/
    --color-text: #f5f5f0;
    --color-muted-text: #e6e6e6;
    --color-accent-border: #c9a227; /* gold */
        color-scheme: dark;
  }

  body {
    margin: 0;
        color: var(--color-text);
    background: var(--color-bg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .page-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    min-height: 60vh;
  }
</style>
