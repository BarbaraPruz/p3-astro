<div class="rotating-words features-title" aria-label="Align Recover Thrive">
  <span>Align</span>
  <span>Recover</span>
  <span>Thrive</span>
</div>
<div class="features-grid">
  <div class="feature">
    <h2>Personalized Sessions</h2>
    <p>Egoscue Postural Analysis & Custom Correction Programs</p>
  </div>
  <div class="feature">
    <h2>Recovery and Wellness</h2>
    <p>Steam Sauna - Red Light Therapy -PEMF Theraypy - BioCharger.</p>
  </div>
  <div class="feature">
    <h2>Movement<br />Classes</h2>
    <p>Posture-Focused Classes for Strength, Mobility and Vitality</p>
  </div>
</div>

<style>
  .features-title {
    font-size: 8rem;
    font-family: var(--font-playfair);
    color: var(--color-text);
    margin: 1.5rem auto;
  }

  .features-grid {
    margin-top: 1rem;
    display: grid;
    /* grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));*/
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
  }
  .feature {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .feature h2 {
    font-size: 2rem;
    font-family: var(--font-montserrat);
    color: var(--color-text);
    margin-bottom: 0;
    text-align: center;
  }
  .feature p {
    color: var(--color-text-muted);
    font-size: 1.25rem;
    margin-bottom: 0;
    text-align: center;
  }

  .rotating-words {
    position: relative;
    height: 1.2em;
    text-align: center;
  }

  .rotating-words span {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: word-fade 12s ease-in-out infinite;
  }
  .rotating-words span:nth-child(1) {
    animation-delay: 0s;
  }

  .rotating-words span:nth-child(2) {
    animation-delay: 4s;
  }

  .rotating-words span:nth-child(3) {
    animation-delay: 8s;
  }

  @keyframes word-fade {
    0% {
      opacity: 0;
    }

    15% {
      opacity: 1;
    }

    35% {
      opacity: 1;
    }

    50% {
      opacity: 0;
    }

    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotating-words span {
      animation: none;
    }

    .rotating-words span:not(:first-child) {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .features-title {
      font-size: 4rem;
    }

    .feature h2 {
      font-size: 1.5rem;
    }

    .feature p {
      font-size: 1rem;
    }
    .features-grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      justify-content: center;
      gap: 0;
    }
  }
</style>
