---
const navLinks = [
  { href: "/studio", label: "Studio" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      P3 Studio Hawaii
    </a>
    <nav class="desktop-nav">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="desktop-nav-link"
              class:list={[{ active: currentPath === link.href }]}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}

        <li>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle dark and light theme"
          >
            <span class="icon-sun">☀</span>
            <span class="icon-moon">☾</span>
          </button>
        </li>
      </ul>
    </nav>
    <button
      class="menu-toggle"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="mobile-menu" class="mobile-nav" aria-label="Main navigation">
      {navLinks.map((item) => (
        <a class="mobile-nav-link" href={item.href}>
          {item.label}
        </a>
      ))}
      <button
        id="mobile-theme-toggle"
        class="theme-toggle mobile-nav-link"
        type="button"
        aria-label="Toggle dark and light theme"
      >
        <span class="icon-sun">☀</span>
        <span class="icon-moon">☾</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const menu = document.querySelector(".mobile-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute(
      "aria-label",
      isOpen ? "Open navigation menu" : "Close navigation menu",
    );
    menu?.classList.toggle("is-open", !isOpen);
  });

  // Close menu when a navigation link is selected
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open navigation menu");
      menu?.classList.remove("is-open");
    });
  });
</script>

<style>
  .site-header {
    position: relative;
    background: var(--color-header-bg);
    color: var(--color-header-text);
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-accent-border);
  }

  .header-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-header-text);
    text-decoration: none;
    font-family: var(--font-playfair);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .desktop-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .desktop-nav a.active {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .desktop-nav-link {
    color: var(--color-header-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }

  .desktop-nav-link:hover {
    color: var(--color-header-text);
    font-size: 1.02rem;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 26px;
    height: 2px;
    background: currentColor;
    margin: 5px 0;
  }

  .mobile-nav {
    display: none;
  }
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--color-header-text-muted);
    border-radius: 999px;
    color: var(--color-header-text);
    cursor: pointer;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    line-height: 1;
    padding: 0;
    transition: border-color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-primary);
  }

  .icon-moon {
    display: none;
  }
  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .mobile-nav {
      display: none;
      position: absolute;
      top: 105%;
      right: 0.25rem;
      min-width: 180px;
      padding: 0.75rem 0 1.5rem;
      background: var(--color-alternate-background);
      color: #222;
      box-shadow: 0 4px 12px rgb(0 0 0 / 15%);
      border-radius: 6px;
      z-index: 100;
    }

    .mobile-nav.is-open {
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-link {
      padding: 0.75rem 1.25rem;
      color: var(--color-text);
    }

    .mobile-nav a:hover {
      background: #f3f3f3;
      opacity: 1;
    }
  }
</style>
