---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>&copy; {year} P3 Studio Hawaii. All rights reserved.</span>
    <ul class="footer-links">
      <li>
        <a
          href="https://instagram.com/p3studiohawaii"
          aria-label="Instagram"
          target="_blank"
        >
          <img
            class="themed-icon"
            data-filename="instagram.svg"
            src="/light/icons/instagram.svg"
            alt=""
            width="20"
            height="20"
          />
        </a>
      </li>
      <li>
        <a
          href="mailto:p3studiohawaii@gmail.com"
          aria-label="Email"
          target="_blank"
        >
          <img
            class="themed-icon"
            data-filename="email.svg"
            src="/light/icons/email.svg"
            alt=""
            width="20"
            height="20"
          />
        </a>
      </li>
      <li>
        <a href="tel:+1-808-258-2579" aria-label="Phone" target="_blank">
          <img
            class="themed-icon"
            data-filename="telephone.svg"
            src="/light/icons/telephone.svg"
            alt=""
            width="20"
            height="20"
          />
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg)
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
    color: var(--color-text-muted);
    padding: 1.5rem;
    margin-top: 3rem;
    border-top: 1px solid var(--color-accent-border);
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: #444;
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 680px) {
    .footer-inner {
      flex-direction: column; /* stack vertically */
      align-items: center; /* center content */
      text-align: center;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>
