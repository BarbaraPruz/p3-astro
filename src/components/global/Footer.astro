---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>3608 Diamond Head Circle<br/>Honolulu, Hawaii 96815<br/>
      <a href="tel:+1-808-258-2579" target="_blank" class="text-link">
        808-258-2579
      </a>
    </div>
    <div class="copyright-desktop">&copy; {year} P3 Studio Hawaii. All rights reserved.</div>
    <div>
      <ul class="footer-links">
        <li>
          <a
            href="https://instagram.com/p3studiohawaii"
            aria-label="Instagram"
            target="_blank"
          >
            <img
              class="themed-icon"
              data-filename="instagram.svg"
              src="/light/icons/instagram.svg"
              alt=""
              width="20"
              height="20"
            />
          </a>
        </li>
        <li>
          <a
            href="mailto:p3studiohawaii@gmail.com"
            aria-label="Email"
            target="_blank"
          >
            <img
              class="themed-icon"
              data-filename="email.svg"
              src="/light/icons/email.svg"
              alt=""
              width="20"
              height="20"
            />
          </a>
        </li>
      </ul>
    </div>
    <div class="copyright-mobile">&copy; {year} P3 Studio Hawaii. All rights reserved.</div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg)
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
    color: var(--color-text-muted);
    padding: 1.5rem;
    margin-top: 3rem;
    border-top: 1px solid var(--color-accent-border);
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    font-size: 0.875rem;
    margin-top: 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-text-link {
    color: var(--color-text);
    text-decoration-color: var(--color-text);
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: var(--color-text);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  .copyright-mobile {
    display: none;
  }
  @media (max-width: 680px) {
    .footer-inner {
      flex-direction: column; /* stack vertically */
      align-items: center; /* center content */
      text-align: center;
      justify-content: center;
      gap: 1rem;
    }

    .copyright-desktop {
      display: none;
    }

    .copyright-mobile {
      display: block;
    }
  }
</style>
