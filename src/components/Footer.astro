---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>&copy; {year} P3 Studio Hawaii. All rights reserved.</p>
    <ul class="footer-links">
      <li>
        <a
          href="https://instagram.com/p3studiohawaii"
          aria-label="Instagram"
          target="_blank"
        >
          <img src="/icons/instagram_black.svg" alt="" width="20" height="20" />
        </a>
      </li>
      <li>
        <a
          href="mailto:p3studiohawaii@gmail.com"
          aria-label="Email"
          target="_blank"
        >
          <img src="/icons/email_black.svg" alt="" width="20" height="20" />
        </a>
      </li>
      <li>
        <a href="tel:+1-808-258-2579" aria-label="Phone" target="_blank">
          <img src="/icons/telephone_black.svg" alt="" width="20" height="20" />
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: #f4f4f8;
    color: #444;
    padding: 1.5rem;
    margin-top: 3rem;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: #444;
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }
</style>
