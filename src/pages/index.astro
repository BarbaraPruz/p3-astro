---
import Layout from "../layouts/Layout.astro";
import Features from "../components/home/Features.astro";
---

<Layout title="Home | P3 Studio Hawaii">
  <section class="hero">
    <img
      class="themed-image"
      data-filename="p3-logo.png"
      src="/light/p3-logo.png"
      alt="P3 Studio Hawaii Logo"
    />
  </section>

  <section class="features-section">
    <Features />
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    margin-top: -1.5rem;
  }

  .hero h1 {
    font-size: 2.25rem;
    margin-bottom: 0;
  }
  .hero img {
    width: 60%;
    height: auto;
    display: block;
    margin: auto;
  }
  .features-section {
    margin-top: 4rem;
    text-align: center;
  }

    @media (max-width: 680px) {
    .hero img {
      width: 80%;
    }
      .features-section {
    margin-top: 2.5rem;}
  }
</style>
