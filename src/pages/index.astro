---
import Layout from "../layouts/Layout.astro";
import Features from "../components/home/Features.astro";
---

<Layout title="Home | P3 Studio Hawaii">
  <section class="hero">
    <img
      class="themed-image"
      data-filename="p3-logo.svg"
      src="/light/p3-logo.svg"
      alt="P3 Studio Hawaii Logo"
    />
  </section>

  <section class="home-section">
    <Features />
  </section>
  <section class="home-section news-section">
    <h2>Class Schedule</h2>
    <p>
      Our small group classes (maximum 8 participants) are 60 minutes.<br />Cost
      is $30 per class.&nbsp;<a href="/contact" class="text-link">Contact Us</a> to
      reserve your space!
    </p>
    <div>
      <div class="schedule-row">
        <div>Morning Class</div><div>Monday-Friday</div><div>
          8:00am - 9:00am
        </div>
      </div>
      <div class="schedule-row">
        <div>Evening Class</div><div>Monday-Friday</div><div>
          7:30pm - 8:30pm
        </div>
      </div>
    </div>
    <div><a class="primary-button" href="/contact">Contact Us</a></div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    /* margin-top: -1.5rem; */
  }

  .hero h1 {
    font-size: 2.25rem;
    margin-bottom: 0;
  }
  .hero img {
    width: 60%;
    height: auto;
    display: block;
    margin: auto;
  }
  .home-section {
    margin-top: 4rem;
    text-align: center;
  }
  .news-section {
    max-width: 90%;
    margin: 4rem auto 0;
    padding: 3rem 2rem 5rem;
    text-align: center;
    background: var(--color-alternate-background);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .news-section h2 {
    font-size: 3rem;
    font-family: var(--font-playfair);
    color: var(--color-text);
    margin: 0;
  }
  .news-section p {
    font-size: 1.25rem;
    font-family: var(--font-montserrat);
    color: var(--color-text);
    margin: 0 auto;
  }

  .schedule-row {
    display: flex;
    width: 60%;
    justify-content: space-between;
    margin: auto;
    font-size: 1.25rem;
    font-family: var(--font-montserrat);
    color: var(--color-text);
  }

  @media (max-width: 680px) {
    .hero img {
      width: 80%;
    }
    .home-section {
      margin-top: 2.5rem;
    }

    .news-section {
      padding: 1.5rem 1rem 3.5rem;
      gap: 1rem;
    }

    .news-section h2 {
      font-size: 2rem;
    }

    .news-section p {
      font-size: 1rem;
    }

    .schedule-row {
      font-size: 1rem;
      width: 90%;
      flex-direction: column;
      margin-bottom: 1rem;
    }
  }
</style>
