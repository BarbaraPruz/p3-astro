---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | P3 Studio Hawaii">
  <h1>Contact Us</h1>
  <div class="contact-info">
    <div>
      <span class="contact-info-label">Address:<br /></span>3608 Diamond Head
      Circle<br />Honolulu, Hawaii 96815<br />
    </div>
    <div>
      <span class="contact-info-label">Phone:<br /></span>
      <a href="tel:+1-808-258-2579" target="_blank" class="text-link">
        808-258-2579
      </a>
    </div>
  </div>
  <section>
    <form
      method="POST"
      class="form-container"
      name="contact"
      data-netlify="true"
      action="/pages/success"
    >
      <div class="contact-input-line">
        <label for="name">Name:</label>
        <input
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          class="contact-input-field"
          required
        />
      </div>

      <div class="contact-input-line">
        <label for="email">Email: </label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          class="contact-input-field"
        />
      </div>

      <div class="contact-input-line">
        <label for="phone">Phone</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          class="contact-input-field"
        />
      </div>

      <div style="margin-top: 1rem;">
        <label for="message">Your Message:<br /></label>
        <textarea
          id="message"
          name="message"
          rows="6"
          class="contact-message-field"
          required></textarea>
      </div>

      <div class="button-panel">
        <button type="submit" class="primary-button">Submit</button>
      </div>
    </form>
  </section>
</Layout>

<style>
  .contact-info {
    width: 50%;
    display: flex;
    justify-content: space-between;
    margin: auto;
  }
  .contact-info-label {
    font-weight: 600;
  }
  h1 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .form-container {
    width: 50%;
    margin: 2rem auto;
    display: flex;
    flex-direction: column;
    font-size: 1.25rem;
    gap: 1rem;
  }

  .contact-input-line {
    display: flex;
    gap: 1rem;
    width: 100%;
  }
  .contact-input-field {
    flex-grow: 1;
    font-size: 1.25rem;
  }
  .contact-message-field {
    width: 100%;
  }
  .button-panel {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  @media (max-width: 680px) {
    .contact-info {
      width: 90%;
      flex-direction: column;
      gap: 1.5rem;
    }

    .form-container {
      width: 90%;
      font-size: 1.1rem;
    }
  }
</style>
